# ============================================================
# BTC Kalshi Tracker - Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit your .env file to git.

# --- Kalshi API (Required for live trading) ---
# Get your API key from: https://kalshi.com/account/api-keys
# Authentication uses RSA key-pair signing.
KALSHI_API_KEY_ID=your-kalshi-key-id-here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Environment: "production" or "demo"
# Start with "demo" to test with paper money before going live.
KALSHI_ENV=demo

# --- Trading Controls ---
# Enable auto-trading (set to "true" to let the bot place orders)
AUTO_TRADE_ENABLED=false

# Maximum dollar amount per trade (in dollars, e.g., 5.00)
MAX_BET_SIZE=5.00

# Maximum total daily exposure (in dollars)
MAX_DAILY_EXPOSURE=50.00

# Minimum EV threshold to place a trade (0.0 - 1.0)
MIN_EV_THRESHOLD=0.05

# Minimum confidence level to trade: "low", "medium", or "high"
MIN_CONFIDENCE=medium

# Maximum number of concurrent open positions
MAX_OPEN_POSITIONS=10

# --- Risk Management ---
# Stop trading if daily P&L drops below this (negative number)
DAILY_LOSS_LIMIT=-25.00

# Kelly fraction (0.0 - 1.0, recommended: 0.25 = quarter Kelly)
KELLY_FRACTION=0.25

# --- App Settings ---
# Flask port
PORT=5050

# Price update interval in seconds
UPDATE_INTERVAL=60

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
